DATABASE_URL=postgres://localhost:5432/enw_dev
TEST_DATABASE_URL=postgres://localhost:5432/enw_test

# Microsoft Graph sending (values live in .env.local / Key Vault, never here)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
# log (default) prints emails; graph really sends
MAIL_MODE=log
# Testing: only these addresses can receive real mail (comma separated). Anything else is
# marked Blocked and never sent, so a test run cannot reach an external vendor.
MAIL_ALLOWED_RECIPIENTS=
# Optional: redirect every outgoing email to this one address instead
MAIL_DEV_RECIPIENT=

# Sign-in. entra (default) = Microsoft SSO, the only way in. dev = local name picker, refused in production.
AUTH_MODE=entra
# Random string, 32+ chars (e.g. openssl rand -base64 48). Signs session cookies.
SESSION_SECRET=
# Public URL of this app. Register APP_URL/api/auth/callback as a Web redirect URI in the Entra app.
APP_URL=http://localhost:3000
# Optional: a separate Entra app for sign-in. Defaults to the GRAPH_* values above.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Retention. Days to keep a closed project's received mail before it is due for purging (0 = due when
# the project closes). Nothing is deleted until `npm run purge-inbox -- --apply` is run.
RETENTION_DAYS_AFTER_CLOSE=0
